[server]
host = "0.0.0.0"
port = 3048
# Base directory for all on-disk storage (databases, indices, scanner metadata).
# Defaults to "data" relative to the server's working directory.
data_dir = "data"
# Legacy database URL field, kept for compatibility. Currently unused.
database_url = "sqlite:data/basis.db"
# Path to PEM-encoded TLS certificate chain. When both this and tls_key_path are
# set, the server listens on HTTPS.
# tls_cert_path = "server.crt"
# Path to PEM-encoded TLS private key.
# tls_key_path = "server.key"
# Maximum nanoERG a single /reserves/create payload may carry (default 10 ERG).
# reserve_creation_max_erg_nano = 10000000000
# Maximum token units a single /reserves/create payload may carry in token-reserve mode.
# reserve_creation_max_token_amount = 1000000000
# Maximum /redemption/build calls per (issuer, recipient) pair per hour (default 60) and per
# recipient across issuers (default 30). Only requests the recipient signed
# (receiver_signature) for a note the tracker holds count, so nobody else can use them up;
# they count before the proof and the cheap checks, so a refused signed request uses one.
# redemption_build_max_per_pair_per_hour = 60
# redemption_build_max_per_recipient_per_hour = 30
# Maximum /redemption/build calls per issuer, and in total, per hour that get as far as
# signing tracker fee inputs (token reserves only; defaults 6 and 30). Requests that fail
# earlier, and ERG-reserve builds (the fee comes out of the payout), do not count.
# redemption_build_max_per_issuer_per_hour = 6
# redemption_build_max_per_hour = 30
# POST /notes needs the issuer's active reserve under this tracker in the note's denomination
# (one reserve, bound to this tracker's NFT, not in refund; 409 otherwise). false allows credit
# without a reserve.
# notes_require_reserve = true
# Note caps, each answered with 429: distinct recipients per issuer, accepted notes per issuer
# per rolling hour, new (issuer, recipient, denomination) edges of one issuer per rolling hour,
# and new edges per rolling hour for all issuers together.
# notes_max_recipients_per_issuer = 50
# notes_max_updates_per_issuer_per_hour = 120
# notes_max_new_edges_per_issuer_per_hour = 10
# notes_max_new_edges_per_hour = 1000
# Round 7 (N9 interim guard): for an owner whose redemptions in a denomination this tracker holds,
# /reserves/create answers 409 reserve_reopen_blocked and the scanner quarantines a new root
# reserve (it would start with an empty R5 and pay those notes again). false turns it off.
# reserve_reopen_guard = true

[server.auth]
# Authentication mode: "none", "api_key", or "signature".
#
# SECURITY: "none" grants EVERY caller Admin. The server therefore refuses to start with
# mode = "none" unless it is bound to a loopback address (127.0.0.1 / ::1 / "localhost").
# Set one of the authenticated modes, or bind to loopback.
mode = "none"
# Escape hatch for the rule above. Leave false unless you have a specific reason: it re-exposes a
# full admin API (including the tracker's wallet) to the network.
# allow_anonymous_non_loopback = false
# Shared API key for server-to-server / MCP clients when mode = "api_key".
# The literal "change-me" is rejected at startup; use a strong random key.
# api_key = "change-me"
# Separate operator credential for Admin routes (/redeem/complete, GET /notes, GET /events*). Required when
# mode = "api_key": `api_key` then grants only Write access, so the key shared with
# ordinary clients cannot drive operator-only endpoints. The server refuses to start
# without it, with the literal "change-me-admin", or with a value equal to api_key.
# admin_api_key = "change-me-admin"
# Escape hatch: allow authenticated operation over plain HTTP on a non-loopback bind.
# Without TLS, API keys and signatures travel unencrypted. Leave false.
# allow_insecure_http_non_loopback = false
# Authorized clients when mode = "signature". Each entry has a 66-character
# compressed secp256k1 public key and a role: "read", "write", or "admin".
# [[server.auth.authorized_clients]]
# pubkey = "020202020202020202020202020202020202020202020202020202020202020202"
# role = "read"
# Origins allowed by CORS. Leave empty to disable CORS entirely: no CORS
# headers are emitted, so only same-origin or non-browser clients can connect.
# List explicit origins to allow cross-origin browser clients.
allowed_origins = []
# Request signature timestamp tolerance in milliseconds (signature mode only).
signature_timestamp_tolerance_ms = 30000

[ergo]
basis_reserve_contract_p2s = ""
# P2S address for token-backed reserves (basis-token.es). One address serves every
# token the tracker supports; the denomination is derived per reserve box from tokens(1).
basis_token_reserve_contract_p2s = ""
# Tracker NFT ID (hex-encoded) - required for reserve creation and redemption
# This NFT identifies the tracker server and must be set in reserve contract R6 register.
# Mint it with supply 1 (singleton): tracker boxes holding more than one token are rejected.
tracker_nft_id = "your_tracker_nft_token_id_here"
# Tokens this tracker serves as reserve collateral
# (specs/ergo/multi_collateral_reserves.md). A token reserve can only be created for a
# token listed here; adding a new token is a config line, not a contract deploy.
# symbol/decimals are display-only; on-chain amounts are always raw integer units.
# min_collateralization_ratio is optional per-token policy metadata.
# Example for USE (Dexy USD):
# [ergo.reserve_tokens."a55b8735ed1a99e46c2c89f8994aacdf4b1109bdcf682f1e5b34479c6e392669"]
# symbol = "USE"
# decimals = 3
# min_collateralization_ratio = 1.1
# Tracker public key - can be hex-encoded public key or P2PK address
tracker_public_key = "your_tracker_public_key_or_p2pk_address_here"
# Tracker secret key (hex-encoded, 32 bytes). REQUIRED: the server signs its tracker box
# commits and redemption signatures in-process with it and refuses to start without it, or
# when it does not belong to tracker_public_key. It is never sent to a node.
# Fee boxes are the token-free boxes at P2PK(tracker_public_key); fund that address.
# WARNING: never commit this value to version control
tracker_secret_key = "your_tracker_secret_key_here"

# Scanner node: chain reads, box scanning and fee-box discovery (/info, /blockchain/*,
# /utxo/*, /blocks/lastHeaders). Public endpoints only: api_key is optional.
# This node MUST run with extraIndex = true (see docs/ergo_node_setup.md).
[ergo.scanner]
start_height = 0
node_url = "http://127.0.0.1:9053"
# api_key = "your_node_api_key_here"
timeout_secs = 30

# Broadcast node: receives signed transactions (POST /transactions) only. No node wallet
# and no API key are needed; no extra indices needed. Uncomment to broadcast through a
# separate node; when unset, the scanner node is used for everything.
# [ergo.wallet]
# node_url = "http://127.0.0.1:9053"
# api_key = "your_wallet_node_api_key_here"

[transaction]
# Default transaction fee in nanoERG (0.001 ERG = 1,000,000 nanoERG)
fee = 1000000
# Heartbeat: when the tracker box is this many blocks old and nothing else is pending, the
# tracker recommits the unchanged digest, so the box never reaches the 2160-block emergency
# redemption window. Each heartbeat costs one fee. Default 720 (about a day); 0 disables.
# heartbeat_blocks = 720
# Token-free nanoERG kept at the tracker address for commits and heartbeats:
# /redemption/build refuses (503) a build that would leave less there.
# Default 100000000 (0.1 ERG); 0 disables.
# commit_reserve_nano = 100000000

[redemption]
# Enforce acceptance-policy compliance at redemption time: reject redemptions that
# would newly violate another debt holder's collateralization policy. When all other
# holders are already violated (distressed reserve), only the oldest outstanding
# note may redeem (FIFO fallback). Emergency redemptions bypass this check.
enforce_acceptance_policy = true

[confirmation]
# Minimum on-chain depth (including the inclusion block) before a tracker box update
# is treated as confirmed and pending notes become redeemable. Presence of the update
# transaction in a block alone is not confirmation.
min_depth = 2
